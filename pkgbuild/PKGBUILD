# Builds this checkout. The published package is pkgbuilds/omasnap in
# omacom/omarchy-pkgs, which builds the release tarball the same way.
pkgname=omasnap
pkgver=1.26.0
pkgrel=1
pkgdesc="Native Wayland screenshot and annotation overlay for Hyprland"
arch=('x86_64' 'aarch64')
url="https://github.com/omacom/omasnap"
license=('MIT' 'OFL-1.1')
depends=(
  'hyprland'
  'layer-shell-qt'
  'libdeflate'
  'qt6-base'
  'tesseract'
  'tesseract-data-eng'
  'wayland'
  'wl-clipboard'
  'xdg-utils'
)
makedepends=(
  'cmake'
  'pkgconf'
  'wayland-protocols'
)
checkdepends=('clang')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  cmake --install build --prefix "$pkgdir/usr"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
